# Image tags built on your local machine.
SAO_SERVER_IMAGE=sao-blog/server:2026.05.20
SAO_WEB_IMAGE=sao-blog/web:2026.05.20

# PostgreSQL
POSTGRES_USER=sao
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_DB=sao_blog

# MinIO
MINIO_ACCESS_KEY=replace-with-your-minio-user
MINIO_SECRET_KEY=replace-with-your-minio-password
MINIO_BUCKET=sao-blog
MINIO_USE_SSL=false

# JWT
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

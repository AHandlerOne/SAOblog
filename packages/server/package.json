{
  "name": "@sao/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @sao/shared build && prisma generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:use-postgres": "node -e \"const fs=require('fs'); fs.copyFileSync('prisma/schema-postgres.prisma', 'prisma/schema.prisma')\"",
    "db:use-sqlite": "node -e \"const fs=require('fs'); fs.copyFileSync('prisma/schema-sqlite.prisma', 'prisma/schema.prisma')\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^8.0.3",
    "@sao/shared": "workspace:*",
    "@prisma/client": "^5.19.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "argon2": "^0.41.1",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.3.0",
    "ioredis": "^5.4.1",
    "jsdom": "^24.1.3",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "prisma": "^5.19.0",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/sanitize-html": "^2.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

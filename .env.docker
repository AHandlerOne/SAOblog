# ===== Docker Deployment Environment =====
# This file is used for full Docker Compose deployment.
# All service hosts use Docker internal network names.

# ===== Database =====
DATABASE_URL=postgresql://sao:sao123@postgres:5432/sao_blog

# ===== Redis =====
REDIS_URL=redis://redis:6379

# ===== MinIO Object Storage =====
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sao-blog
MINIO_USE_SSL=false

# ===== Authentication =====
# IMPORTANT: Change this to a random string with at least 32 characters in production
JWT_SECRET=your-jwt-secret-change-this-to-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Application =====
PORT=3000
NODE_ENV=production
UPLOAD_DIR=./uploads

